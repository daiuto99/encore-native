<?xml version="1.0" encoding="utf-8"?>
<!-- Splash screen icon — self-contained circle so it renders correctly on all API levels.
     White oval background prevents the bitmap rectangle from showing through. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Circle background -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
    <!-- Mark inset so the orange note sits well inside the circle -->
    <item
        android:left="40dp"
        android:top="40dp"
        android:right="40dp"
        android:bottom="40dp">
        <bitmap
            android:src="@drawable/encore_mark"
            android:gravity="center" />
    </item>
</layer-list>
